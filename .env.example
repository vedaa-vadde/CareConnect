# ==========================================
# CareConnect - Root Environment Config
# ==========================================

# Backend Configuration (server/.env)
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/careconnect

# JWT Authentication Secrets
JWT_SECRET=careconnect_jwt_super_secret_key_minimum_32_chars_2026
JWT_REFRESH_SECRET=careconnect_jwt_refresh_secret_key_min_32_chars_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google Gemini AI Key (Optional: rule-based fallback active if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend Origins (CORS)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File Upload Limit
MAX_FILE_SIZE=10485760

# Frontend Configuration (client/.env)
VITE_API_URL=http://localhost:5001/api
